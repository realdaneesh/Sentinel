# Sentinel Environment Configuration Example
# Copy this file to .env and adjust variables as needed for your environment.
# Never commit actual production secrets to source control.

# Application Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Sentinel Platform"
API_V1_PREFIX="/api/v1"

# Database Configuration
# Default uses local SQLite. For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/sentinel
DATABASE_URL=sqlite:///./sentinel.db
DATABASE_ECHO=false

# Security & Authentication
# Generate a stable local secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Replace this intentionally invalid placeholder; never commit the actual value.
SECRET_KEY=REPLACE_WITH_A_RANDOMLY_GENERATED_SIGNING_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SIMULATOR_PERSISTENCE_ENABLED=false

# Detection & Ingestion Settings
DETECTOR_VERSION=1.0.0
DEFAULT_CORRELATION_WINDOW_MINUTES=15
BURST_THRESHOLD=5
BURST_WINDOW_MINUTES=15
MIN_HISTORY_FOR_NOVELTY=1

