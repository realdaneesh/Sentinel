# Sentinel Environment Configuration Example
# Copy this file to .env and adjust variables as needed for your environment.
# Never commit actual production secrets to source control.

# Application Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Sentinel Platform"
API_V1_PREFIX="/api/v1"

# Database Configuration
# Default uses local SQLite. For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/sentinel
DATABASE_URL=sqlite:///./sentinel.db
DATABASE_ECHO=false

# Security & Authentication
# Generate a secure secret using: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_TO_A_SECURE_RANDOM_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Detection & Ingestion Settings
DETECTOR_VERSION=1.0.0
DEFAULT_CORRELATION_WINDOW_MINUTES=15
BURST_THRESHOLD=5
BURST_WINDOW_MINUTES=15
MIN_HISTORY_FOR_NOVELTY=1

